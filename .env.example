# Public browser origin used for same-origin validation. Do not add a path.
FCS_PUBLIC_ORIGIN=http://127.0.0.1:5173

# These values are intentionally empty. Set each to a different unpadded
# base64url encoding of exactly 32 random bytes using the README command.
FCS_SESSION_HMAC_SECRET=
FCS_CSRF_HMAC_SECRET=
FCS_RATE_LIMIT_HMAC_SECRET=
